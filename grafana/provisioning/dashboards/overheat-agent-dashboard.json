          "rawSql": "SELECT\n  $__timeGroupAlias(sd.time, '1h'),\n  srv.hostname AS metric,\n  AVG(sd.value) AS value\nFROM sensor_data sd\nJOIN sensor s ON s.sensor_id = sd.sensor_id\nJOIN server srv ON srv.server_id = s.server_id\nWHERE s.sensor_type = 'CPU_TEMP'\n  AND $__timeFilter(sd.time)\nGROUP BY 1, srv.hostname\nORDER BY 1;",
