      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  srv.hostname,\n  ROUND(MAX(CASE WHEN s.sensor_type = 'CPU_TEMP' THEN sd.value END)::numeric, 2) AS max_cpu_temp,\n  COUNT(*) FILTER (WHERE s.sensor_type = 'CPU_TEMP' AND sd.value >= 70) AS points_over_70,\n  ROUND(AVG(CASE WHEN s.sensor_type LIKE 'FAN_SPEED_%' THEN sd.value END)::numeric, 2) AS avg_fan_speed,\n  ROUND(AVG(CASE WHEN s.sensor_type = 'SERVER_POWER_W' THEN sd.value END)::numeric, 2) AS avg_power_w\nFROM sensor_data sd\nJOIN sensor s ON s.sensor_id = sd.sensor_id\nJOIN server srv ON srv.server_id = s.server_id\nWHERE $__timeFilter(sd.time)\nGROUP BY srv.hostname\nORDER BY max_cpu_temp DESC;",
          "refId": "A"
        }
      ],
      "title": "Résumé par serveur",
      "type": "table"
