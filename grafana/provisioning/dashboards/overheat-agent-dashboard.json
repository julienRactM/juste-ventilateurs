          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH fan_by_server_tick AS (\n  SELECT\n    sd.time,\n    s.server_id,\n    AVG(sd.value) AS fan_speed\n  FROM sensor_data sd\n  JOIN sensor s ON s.sensor_id = sd.sensor_id\n  WHERE s.sensor_type LIKE 'FAN_SPEED_%'\n    AND $__timeFilter(sd.time)\n  GROUP BY sd.time, s.server_id\n)\nSELECT COUNT(*) AS ml_cooling_actions\nFROM fan_by_server_tick\nWHERE fan_speed > 35.5;",
          "refId": "A"
        }
      ],
      "title": "Actions refroidissement ML",
