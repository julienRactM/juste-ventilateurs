          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_tick AS (\n  SELECT MAX(sd.time) AS time\n  FROM sensor_data sd\n  JOIN sensor s ON s.sensor_id = sd.sensor_id\n  WHERE s.sensor_type = 'CPU_TEMP'\n    AND $__timeFilter(sd.time)\n)\nSELECT ROUND(MAX(sd.value)::numeric, 2) AS current_max_cpu_temp\nFROM sensor_data sd\nJOIN sensor s ON s.sensor_id = sd.sensor_id\nJOIN latest_tick lt ON lt.time = sd.time\nWHERE s.sensor_type = 'CPU_TEMP';",
          "refId": "A"
        }
      ],
      "title": "Température actuelle max",
      "type": "stat"
