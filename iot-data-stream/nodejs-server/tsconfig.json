{
  "compilerOptions": {
    "target": "es2023", 
    "module": "nodenext", 
    "moduleResolution": "nodenext",
    // "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src", // On change rootDir pour inclure la racine
    "resolveJsonModule": true,
    "lib": ["es2023"],
    "types": ["node"],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts", 
  ],
  "exclude": ["node_modules", "dist"]
}